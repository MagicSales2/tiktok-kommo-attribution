# ============================================================
# TikTok <-> Kommo Attribution
# Copia este archivo a .env y rellena los valores.
# Nunca subas .env al repositorio.
# ============================================================

# Dominio público del servicio (debe apuntar al VPS con un registro A).
DOMAIN=track.tudominio.com
PUBLIC_BASE_URL=https://track.tudominio.com

# Traefik existente en el VPS.
TRAEFIK_NETWORK=traefik-proxy
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure

# Clave para cifrar los secretos guardados desde /settings.
# Install.sh la genera. Si la cambias, vuelve a guardar los secretos en el panel.
SECRET_KEY=
SECRET_KEY_FILE=/app/data/secret.key

# PostgreSQL privado (solo visible entre los contenedores).
POSTGRES_DB=attribution
POSTGRES_USER=attribution
# Usa solo letras/números (sin @ : / #) para que la URL de conexión sea válida.
POSTGRES_PASSWORD=cambia-esta-clave-larga
# Solo para ejecutar fuera de Docker. En Docker, docker-compose.yml la construye
# automáticamente con las tres variables POSTGRES_* de arriba.
DATABASE_URL=postgresql://attribution:cambia-esta-clave-larga@db:5432/attribution

# ------------------------------------------------------------
# KOMMO
# ------------------------------------------------------------
# Estos datos también se pueden dejar vacíos aquí y configurarlos en /settings.
# Lo guardado en el panel tiene prioridad sobre este archivo.
# Subdominio solamente, sin https:// y sin .kommo.com
KOMMO_SUBDOMAIN=
# Token de larga duración de Kommo (Integraciones -> API).
KOMMO_TOKEN=
# Opcional: si lo pones, solo se procesan leads de este pipeline.
KOMMO_PIPELINE_ID=
# Secreto que Kommo enviará en la URL del webhook: ?secret=...
# También se acepta la ruta /webhook/kommo/TU_SECRETO si Kommo elimina el query.
KOMMO_WEBHOOK_SECRET=
# IDs de campos personalizados de Kommo (opcionales).
KOMMO_FIELD_TTCLID=
KOMMO_FIELD_REF=
KOMMO_FIELD_VALUE=
KOMMO_FIELD_CURRENCY=
KOMMO_FIELD_CONSENT=

# Mapa de etapas del pipeline -> evento de TikTok.
# Formato JSON: {"STATUS_ID":{"key":"nombre","rank":N,"event":"Evento"}}
# rank define el orden del embudo: solo se envía cuando sube de rank.
# Ejemplo para TIKTOK_EVENT_SOURCE=web (eventos estándar):
KOMMO_STAGE_MAP={"000001":{"key":"nuevo","rank":1,"event":"Contact"},"000002":{"key":"interesado","rank":2,"event":"SubmitForm"},"000003":{"key":"calificado","rank":3,"event":"CompleteRegistration"},"000004":{"key":"compra","rank":4,"event":"Purchase"}}
# Si usas TIKTOK_EVENT_SOURCE=crm, cambia los event por nombres personalizados
# (ej. LeadNuevo, LeadInteresado, LeadCalificado, Compra) y mapealos en Events Manager.

# ------------------------------------------------------------
# TIKTOK
# ------------------------------------------------------------
# También se puede configurar en /settings (recomendado; los secretos quedan cifrados).
# web      -> Pixel + ttclid (recomendado si el clic pasa por /r)
# crm      -> CRM Event Set + lead_id (recomendado para Lead Generation)
# offline  -> Offline Event Set + eventos estándar
TIKTOK_EVENT_SOURCE=web
TIKTOK_PIXEL_ID=
# Solo para TIKTOK_EVENT_SOURCE=crm u offline.
TIKTOK_EVENT_SET_ID=
TIKTOK_ACCESS_TOKEN=
# Código de evento de prueba de Events Manager. Quítalo en producción.
TIKTOK_TEST_EVENT_CODE=
TIKTOK_CURRENCY=COP
TIKTOK_DEFAULT_VALUE=0
# URL que se manda como page.url en modo web si el clic no trae landing_url.
TIKTOK_WEB_PAGE_URL=

# ------------------------------------------------------------
# WHATSAPP / PUENTE DE ATRIBUCIÓN
# ------------------------------------------------------------
# Número en formato internacional, solo dígitos. Ej: 573001234567
WHATSAPP_NUMBER=
# El marcador {ref} es obligatorio: es lo que permite unir el clic con el lead.
WHATSAPP_MESSAGE_TEMPLATE=Hola, quiero información. {ref}
# Código de país para normalizar teléfonos de 10 dígitos.
DEFAULT_COUNTRY_CODE=57

# ------------------------------------------------------------
# PANEL / SEGURIDAD
# ------------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambia-esta-clave
# Si es true, el webhook exige ?secret=... o el header X-Webhook-Secret.
REQUIRE_WEBHOOK_SECRET=true
# Guarda el payload crudo de Kommo (útil para depurar; contiene datos personales).
STORE_RAW_PAYLOADS=true

# ------------------------------------------------------------
# WORKER
# ------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1
# Espera a que llegue add_message (con el REF) antes de procesar add_lead.
LEAD_JOB_DELAY_SECONDS=5
MAX_ATTEMPTS=8
LOG_LEVEL=INFO
